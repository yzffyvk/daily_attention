NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
SUPABASE_SECRET_KEY=replace-with-local-service-role-key
AUTH_RATE_LIMIT_PEPPER=replace-with-at-least-32-random-bytes
APP_ORIGIN=http://127.0.0.1:3000
AI_GENERATION_ENABLED=
# Legacy Edge worker only; the dedicated Node worker does not need this token.
AI_WORKER_TRIGGER_TOKEN=
AI_MAINTENANCE_TOKEN=
AI_USER_ID_PEPPER=
AI_PROVIDER_MODE=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
SAFE_FETCH_GATEWAY_URL=http://127.0.0.1:8788
SAFE_FETCH_GATEWAY_TOKEN=
AI_WORKER_HEALTH_PORT=8790
# Payments: sandbox reads the protected .alipay-sandbox.json with npm run dev:payments.
# Keep production sales closed until signing, public notifications and deployment acceptance finish.
PAYMENTS_ENABLED=false
ALIPAY_ENV=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_NOTIFY_URL=
PAYMENT_ADMIN_TOKEN=
